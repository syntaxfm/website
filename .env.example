# Local Postgres from docker-compose.yml. `pnpm preheat` starts it and fills it from prod.
DATABASE_URL='postgresql://root:mysecretpassword@localhost:5434/local'
# Production Postgres — used ONLY by `pnpm preheat` / `pnpm db:pull` to copy data locally.
# Core team: grab a read-only connection string from PlanetScale. Never set this as DATABASE_URL.
PROD_DATABASE_URL=''
PUBLIC_URL='localhost'
# Cloudflare Turnstile always-pass test keys
PUBLIC_TURNSTILE_SITE_KEY='1x00000000000000000000AA'
TURNSTILE_SECRET='1x0000000000000000000000000000000AA'

# ─── Optional: only needed for the features noted ───
# Transcript generation
DEEPGRAM_SECRET=''
# AI show notes
OPENAI_API_KEY=''
ANTHROPIC_KEY=''
# Guards /webhooks/* and /cron/* endpoints
CRON_SECRET=''
# Video sync
YOUTUBE_API_KEY=''
# Megaphone episode sync
MEGAPHONE_API_TOKEN=''
MEGAPHONE_NETWORK_ID=''
MEGAPHONE_PODCAST_ID=''
# Newsletter signup
CONVERT_KIT_SECRET=''
CONVERT_KIT_V4_API_KEY=''
# Error tracking / coverage uploads at build time
SENTRY_AUTH_TOKEN=''
CODECOV_TOKEN=''
