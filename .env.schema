# Env schema for the Syntax website — see https://varlock.dev
# Defaults below are enough to run locally against the Docker DB from `pnpm preheat`.
# Core team: set USE_1PASSWORD=true in .env.local to pull real secrets from 1Password.
# Everyone else: put your own values in .env.local (gitignored).
#
# @defaultRequired=false
# @defaultSensitive=inferFromPrefix(PUBLIC_)
# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_TOKEN, allowAppAuth=true, account=sentry.1password.com)
# @import(./.env.1password, enabled=$USE_1PASSWORD)
# ---

# Load secrets from the Syntax.fm 1Password vault (needs the 1Password CLI + desktop app integration)
# @type=boolean @sensitive=false
USE_1PASSWORD=false

# 1Password service account token for CI/deploys. Locally the desktop app is used instead.
# @type=opServiceAccountToken @sensitive @internal
OP_TOKEN=

# Local Postgres from docker-compose.yml. `pnpm preheat` starts it and fills it from prod.
# @required @type=url
DATABASE_URL=postgresql://root:mysecretpassword@localhost:5434/local

# Production Postgres — used ONLY by `pnpm preheat` / `pnpm db:pull` to copy data locally. Read-only is fine.
# @type=url
PROD_DATABASE_URL=

# Overrides DATABASE_URL in the app and drizzle-kit. Leave unset for local dev.
# @type=url
POSTGRES_DATABASE_URL=

# Source MySQL for scripts/direct-db-migration.js
# @type=url
MYSQL_DATABASE_URL=

# @required
PUBLIC_URL=localhost

# Cloudflare Turnstile — defaults are the always-pass test keys
# @required
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# @required
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Transcript generation
DEEPGRAM_SECRET=

# AI show notes
OPENAI_API_KEY=
ANTHROPIC_KEY=

# Guards /webhooks/* and /cron/* endpoints
CRON_SECRET=

# Video sync
YOUTUBE_API_KEY=

# Megaphone episode sync
MEGAPHONE_API_TOKEN=
# @sensitive=false
MEGAPHONE_NETWORK_ID=
# @sensitive=false
MEGAPHONE_PODCAST_ID=

# Newsletter signup
CONVERT_KIT_SECRET=
CONVERT_KIT_V4_API_KEY=

# Sentry source map uploads at build time
SENTRY_AUTH_TOKEN=

# Codecov bundle analysis at build time
CODECOV_TOKEN=
