# Env schema for the Syntax website — see https://varlock.dev
# Defaults below are enough to run locally against the Docker DB from `pnpm preheat`.
# Core team: `pnpm preheat` (or `pnpm env:pull`) copies the secrets listed in .env.1password from
# 1Password into .env.local, with one 1Password approval.
# Everyone else: put your own values in .env.local (gitignored).
#
# @defaultRequired=false
# @defaultSensitive=inferFromPrefix(PUBLIC_)
# ---

# Copy secrets from the Syntax.fm 1Password vault into .env.local on preheat / env:pull
# @type=boolean @sensitive=false
USE_1PASSWORD=false

# Local Postgres from docker-compose.yml. `pnpm preheat` starts it and fills it from prod.
# @required @type=url
DATABASE_URL=postgresql://root:mysecretpassword@localhost:5434/local

# Production Postgres — used ONLY by `pnpm preheat` / `pnpm db:pull` to copy data locally. Read-only is fine.
# @type=url
PROD_DATABASE_URL=

# Overrides DATABASE_URL in the app and drizzle-kit. Leave unset for local dev.
# @type=url
POSTGRES_DATABASE_URL=

# Source MySQL for scripts/direct-db-migration.js
# @type=url
MYSQL_DATABASE_URL=

# @required
PUBLIC_URL=localhost

# Development only: extra browser-facing origins of `pnpm dev`, separated by commas or spaces, such as
# a name other than an IP or localhost (http://devbox.example.com:5740) or the https origin of an
# HTTPS proxy you run (https://dev.example.com). Sign-in and sign-out work there. See README.
# @sensitive=false
SYNTAX_AUTH_PUBLIC_ORIGINS=

# Cloudflare Turnstile — defaults are the always-pass test keys
# @required
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# @required
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Transcript generation (Grok speech-to-text; Deepgram made the older ones)
XAI_API_KEY=

# AI show notes
OPENAI_API_KEY=
ANTHROPIC_KEY=

# AI tagging (models by name through OpenRouter)
OPENROUTER_API_KEY=

# Issue reports (the Report button in the admin menu): a fine-grained GitHub token that can write
# issues in syntaxfm/website. Claude triages each report with ANTHROPIC_KEY first.
GITHUB_ISSUES_TOKEN=

# Guards /webhooks/* and /cron/* endpoints, and lets agents open admin-only issue screenshots
CRON_SECRET=

# Video sync
YOUTUBE_API_KEY=
# Video captions: the "Syntax website" OAuth client (an internal app in our Google org). Only the
# channel owner can download captions; an admin signs in once with Connect YouTube on
# /admin/content/videos and the site keeps that sign-in in the database.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# SEO tracker (/admin/seo): Firecrawl Alexandria, for DataForSEO and YouTube search data.
# Optional: without it the page shows saved snapshots and can't take new ones.
FIRECRAWL_API_KEY=

# Megaphone episode sync
MEGAPHONE_API_TOKEN=
# @sensitive=false
MEGAPHONE_NETWORK_ID=
# The Syntax podcast (feed.syntax.fm → feeds.megaphone.fm/FSI1483080183). The network also has an
# older import with the same title (cefb0040-…, 894 episodes); that's not it.
# @sensitive=false
MEGAPHONE_PODCAST_ID=5197fe5a-42f7-11f0-affd-87d9985a1760

# Newsletter signup
CONVERT_KIT_SECRET=
CONVERT_KIT_V4_API_KEY=

# Sentry source map uploads at build time
SENTRY_AUTH_TOKEN=

# Codecov bundle analysis at build time
CODECOV_TOKEN=
