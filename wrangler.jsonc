{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "syntax-website",
	// The Syntax Cloudflare account, which also holds the syntax.fm zone and Syntax Auth
	"account_id": "3ebe60b8bb090efeda7702aff60769bb",
	// beta.syntax.fm is attached in the dashboard; list it under "routes" with custom_domain: true
	// once attached, or the next deploy detaches it.
	"workers_dev": true,
	// The Worker that @sveltejs/adapter-cloudflare builds (pnpm build)
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-11-01",
	// postgres.js, Deepgram streams and Sentry need Node APIs
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	}
}
