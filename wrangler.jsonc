{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "syntax-website",
	// The Worker that @sveltejs/adapter-cloudflare builds (pnpm build)
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-11-01",
	// postgres.js, Deepgram streams and Sentry need Node APIs
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	}
}
