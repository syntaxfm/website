{
	"name": "syntax",
	"version": "2.1.438",
	"private": true,
	"scripts": {
		"dev": "node ./scripts/preheat.js",
		"preheat": "node ./scripts/preheat.js --env-only",
		"vite-dev": "vite dev",
		"build": "vite build",
		"build:cached": "node ./scripts/build-if-changed.js",
		"preview": "vite preview",
		"test": "svelte-kit sync && playwright test",
		"test:ui": "svelte-kit sync && playwright test --ui",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "svelte-kit sync && vitest",
		"eslint": "eslint .",
		"lint": "prettier --check . && eslint . && pnpm stylelint",
		"format": "prettier --write .",
		"site:update": "pnpm update -i -L",
		"db:studio": "prisma studio",
		"db:generate": "prisma generate",
		"db:push": "prisma db push",
		"db:seed": "prisma db seed",
		"i-changed-the-schema": "pnpm run db:push && pnpm run db:generate",
		"postinstall": "pnpm db:generate && pnpm exec playwright install",
		"stylelint": "NODE_OPTIONS=--no-deprecation stylelint \"**/*.css\""
	},
	"devDependencies": {
		"@codecov/sveltekit-plugin": "^2.0.1",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/chroma-js": "^3.1.3",
		"@types/js-cookie": "^3.0.6",
		"@types/node": "^22.16.0",
		"@types/speakingurl": "^13.0.6",
		"@typescript-eslint/eslint-plugin": "^8.72.0",
		"@typescript-eslint/parser": "^8.72.0",
		"dotenv": "^18.0.8",
		"dotenv-expand": "^13.0.0",
		"eslint": "^10.13.0",
		"globals": "^17.13.0",
		"mysql2": "^3.14.1",
		"postcss": "^8.5.6",
		"postcss-import": "^17.0.1",
		"postcss-preset-env": "^11.6.1",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^4.1.1",
		"prisma": "6.19.3",
		"semver": "^7.7.2",
		"stylelint": "^17.16.0",
		"stylelint-config-standard": "^40.0.0",
		"stylelint-declaration-strict-value": "^1.12.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.5",
		"svelte-eslint-parser": "^1.9.0",
		"svelte-preprocess": "^6.0.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"type": "module",
	"packageManager": "pnpm@12.8.1",
	"engines": {
		"node": "^22",
		"pnpm": ">=12"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.6.8",
		"@deepgram/sdk": "^4.11.2",
		"@ffmpeg.wasm/core-mt": "0.13.2",
		"@ffmpeg.wasm/main": "^0.13.1",
		"@leveluptuts/svelte-side-menu": "^1.1.0",
		"@oddbird/popover-polyfill": "^0.7.3",
		"@prisma/client": "6.19.3",
		"@sentry/profiling-node": "^11.9.0",
