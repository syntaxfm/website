		"@sparticuz/chromium": "153.0.0",
		"@svelte-put/shortcut": "^4.2.0",
		"@sveltejs/adapter-vercel": "^7.0.1",
		"@upstash/redis": "^1.35.1",
		"chroma-js": "^3.2.0",
		"core-js": "^3.44.0",
		"date-fns": "^4.4.0",
		"flexsearch": "^0.8.212",
		"gpt-3-encoder": "^1.1.4",
		"gray-matter": "^4.0.3",
		"js-cookie": "^3.0.5",
		"linkedom": "^0.18.11",
		"media-chrome": "^4.19.3",
		"openai": "^3.3.0",
		"p-map": "^7.0.3",
		"puppeteer-core": "25.11.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-highlight": "^7.0.2",
		"rehype-raw": "^7.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-heading-id": "^1.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"sk-form-data": "^2.0.2",
		"speakingurl": "^14.0.1",
		"svelte-french-toast": "1.2.0",
		"svelte-persisted-store": "^0.12.0",
		"svelte-turnstile": "^0.11.0",
		"sveltekit-search-params": "^4.0.1",
		"ts-node": "^10.9.2",
		"unified": "^11.0.5",
		"waait": "^1.0.5",
		"youtube-video-element": "^1.9.1",
		"zod": "^4.6.7"
	},
	"prisma": {
		"seed": "node --loader ts-node/esm prisma/seed.ts"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
